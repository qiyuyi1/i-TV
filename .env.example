# ============================================
# 影视资源分享网站 — 环境变量配置
# ============================================
# 本地开发：复制此文件为 .env.local 并填入真实值
# Vercel 部署：在 Settings → Environment Variables 中逐项添加

# Supabase PostgreSQL 数据库连接串
# 在 Supabase → Settings → Database → Connection string → URI 中获取
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.XXX.supabase.co:5432/postgres?schema=public&sslmode=require"

# NextAuth 密钥（已自动生成，保持不变）
NEXTAUTH_SECRET="ff62135641b6435fffdd9ed83580070b425ee277e352b679bf8048f32e50f9d5"

# 本地开发地址
NEXTAUTH_URL="http://localhost:3000"

# 图片支持：直接填完整URL（https://开头）即可